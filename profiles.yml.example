# Copy this to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR to this repo).
# Default target is local DuckDB — zero setup, no credentials needed.
#
# The `snowflake` and `bigquery` targets are included commented-out to show
# this project is warehouse-agnostic — swapping targets is a config change,
# not a rewrite of any model SQL. Worth mentioning in interviews.

uk_data_jobs_pipeline:
  target: dev
  outputs:

    dev:
      type: duckdb
      path: 'data/warehouse.duckdb'
      threads: 4

    ci:
      type: duckdb
      path: 'data/ci_warehouse.duckdb'
      threads: 4

    # prod:
